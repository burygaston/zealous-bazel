[java_test(
    name = "SecurityTest_%d" % i,
    srcs = ["src/test/java/com/harness/security/SecurityTest_%d.java" % i],
    test_class = "com.harness.security.SecurityTest_%d" % i,
    deps = [
        "@maven//:junit_junit",
        "@maven//:com_google_inject_guice",
